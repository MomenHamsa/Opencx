#!/bin/sh
# Refuse to commit anything that looks like a live API key.
#
# This exists because it already happened once: a real key was pasted into
# .env.example — a committed file — and `git add -A` swept it into a commit. It was
# caught before pushing, but "caught before pushing" is luck, not a control.
#
# Enable with:  git config core.hooksPath .githooks

if git diff --cached -U0 | grep -nE '^\+.*(sk-ant-[A-Za-z0-9_-]{20,}|sk-proj-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,})' >/dev/null 2>&1; then
  echo ""
  echo "BLOCKED: a staged change contains something shaped like an API key."
  echo ""
  git diff --cached --name-only | sed 's/^/  staged: /'
  echo ""
  echo "  Keys belong in .env (gitignored), never in a committed file."
  echo "  If this is a false positive: git commit --no-verify"
  echo ""
  exit 1
fi
