# The app runs fully offline with the `mock` provider and needs none of this.
# Copy to .env and add a key only if you want to flip the provider selector to a
# real model. Never commit .env — it is gitignored.

# Anthropic API key. Without it, the "real" option in the UI stays disabled.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5 when unset.
LLM_MODEL=claude-opus-5
