# The app runs fully offline on the `mock` provider and needs none of this.
#
# Copy this file to .env and put your keys THERE — .env is gitignored, this file
# is committed. Never put a real key in this file, and never paste one into a chat.
#
#   cp .env.example .env
#
# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini (cheap, good for iterating).
# Run `npm run models` to see what your key can actually reach.
OPENAI_MODEL=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=

# --- Grading -----------------------------------------------------------------
# Optional. Model used for the grounding judge when you enable it in the UI.
# Defaults to whatever model the run itself uses — but judging a model's output
# with the same model is a known weakness (it likes its own work), so point this
# at something stronger when the verdict matters.
JUDGE_MODEL=

# --- Access ------------------------------------------------------------------
# Leave empty for local development and the app is open.
# SET THIS BEFORE DEPLOYING: the deployed app holds an API key and will spend it
# on request, so a public URL with no gate is an invitation to burn your credits.
APP_PASSWORD=
